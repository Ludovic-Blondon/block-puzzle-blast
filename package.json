{
  "name": "block-puzzle-blast",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "android:build": "expo run:android",
    "ios": "expo run:ios",
    "ios:build": "open -a Simulator && expo run:ios",
    "web": "expo start --web",
    "xcode": "bash scripts/build-ios.sh",
    "xcode:release": "bash scripts/build-ios-release.sh",
    "ios:device": "npx expo prebuild --clean --platform ios && npx expo run:ios --device --configuration Release",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-haptics": "~55.0.8",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-localization": "^55.0.9",
    "expo-router": "~55.0.5",
    "expo-sharing": "~55.0.12",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "i18next": "^26.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.1",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-view-shot": "4.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  },
  "private": true
}
